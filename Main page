<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Marvel Canon Watchlist Tracker</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
.completed {
text-decoration: line-through;
color: #9ca3af;
}
@media print {
.no-print { display: none; }
body { background: white; color: black; }
}
</style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 sm:p-8">
<div class="max-w-4xl mx-auto bg-slate-800 rounded-xl shadow-2xl overflow-hidden border border-slate-700">
​<!-- Header Section -->
<div class="bg-red-700 p-6 sm:p-8 text-white flex flex-col sm:flex-row justify-between items-center gap-4">
<div>
<h1 class="text-3xl font-extrabold tracking-wider uppercase font-sans">Marvel Canon Tracker</h1>
<p class="text-red-100 text-sm mt-1">Complete Multiverse Canon Watchlist (Sorted by Release Date)</p>
</div>
<div class="flex gap-2 no-print">
<button onclick="exportData()" class="bg-red-900 hover:bg-red-950 text-white font-medium py-2 px-4 rounded transition text-sm">
Export Progress
</button>
<button onclick="resetList()" class="bg-red-900/50 hover:bg-red-950/80 text-white font-medium py-2 px-4 rounded transition text-sm">
Reset
</button>
</div>
</div>
​<!-- Progress Bar -->
<div class="bg-slate-750 p-4 border-b border-slate-700">
<div class="flex justify-between items-center mb-2">
<span class="text-sm font-semibold text-slate-300">Overall Completion</span>
<span id="progressText" class="text-sm font-bold text-red-400">0 / 0 (0%)</span>
</div>
<div class="w-full bg-slate-700 rounded-full h-3 overflow-hidden">
<div id="progressBar" class="bg-red-600 h-3 rounded-full transition-all duration-300" style="width: 0%"></div>
</div>
</div>
​<!-- Film List Table -->
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-slate-900/50 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-700">
<th class="p-4 w-12 text-center">Status</th>
<th class="p-4 w-12 text-center">#</th>
<th class="p-4">Film Title</th>
<th class="p-4 hidden sm:table-cell">Release Date</th>
<th class="p-4 w-48">Date Watched</th>
</tr>
</thead>
<tbody id="movieTableBody" class="divide-y divide-slate-700/50 text-sm">
<!-- JavaScript will dynamically render movies here -->
</tbody>
</table>
</div>
​<!-- Footer -->
<div class="p-4 bg-slate-900/50 text-xs text-slate-400 text-center border-t border-slate-700">
Progress automatically saved to your browser local storage.
</div>
</div>
​<script>
