{ id: 55, title: "The Fantastic Four: First Steps", releaseDate: "July 25, 2025" },
{ id: 56, title: "Spider-Man: Brand New Day", releaseDate: "July 31, 2026" },
{ id: 57, title: "Avengers: Doomsday", releaseDate: "December 18, 2026" }
];
​let state = JSON.parse(localStorage.getItem('marvel_watchlist_state')) || {};
​function renderTable() {
const tbody = document.getElementById('movieTableBody');
tbody.innerHTML = '';
​let watchedCount = 0;
​movies.forEach(movie => {
const isWatched = state[movie.id]?.watched || false;
const watchedDate = state[movie.id]?.date || '';
​if (isWatched) watchedCount++;
​const tr = document.createElement('tr');
tr.className = hover:bg-slate-750/50 transition ${isWatched ? 'bg-slate-900/30' : ''};
​tr.innerHTML = <td class="p-4 text-center"> <input type="checkbox"  ${isWatched ? 'checked' : ''}  onchange="toggleMovie(${movie.id}, this.checked)" class="w-5 h-5 rounded bg-slate-700 border-slate-600 text-red-600 focus:ring-red-500 focus:ring-offset-slate-800 cursor-pointer"> </td> <td class="p-4 text-center font-mono text-slate-500">${movie.id}</td> <td class="p-4 font-semibold ${isWatched ? 'completed' : 'text-slate-100'}"> ${movie.title} <div class="text-xs text-slate-400 font-normal sm:hidden mt-0.5">${movie.releaseDate}</div> </td> <td class="p-4 text-slate-400 hidden sm:table-cell">${movie.releaseDate}</td> <td class="p-4"> <input type="date"  value="${watchedDate}" onchange="updateDate(${movie.id}, this.value)" class="bg-slate-700 text-slate-200 text-xs rounded p-1.5 border border-slate-600 focus:outline-none focus:border-red-500 w-full max-w-[150px]"> </td>;
​tbody.appendChild(tr);
});
​// Update Progress Bar
const total = movies.length;
const percentage = Math.round((watchedCount / total) * 100);
document.getElementById('progressBar').style.width = ${percentage}%;
document.getElementById('progressText').textContent = ${watchedCount} / ${total} (${percentage}%);
}
​function toggleMovie(id, isChecked) {
if (!state[id]) state[id] = {};
​state[id].watched = isChecked;
if (isChecked && !state[id].date) {
// Set today's date in YYYY-MM-DD format
state[id].date = new Date().toISOString().split('T')[0];
} else if (!isChecked) {
state[id].date = '';
}
​saveAndRender();
}
​function updateDate(id, dateValue) {
if (!state[id]) state[id] = {};
state[id].date = dateValue;
if (dateValue && !state[id].watched) {
state[id].watched = true;
}
saveAndRender();
}
​function saveAndRender() {
localStorage.setItem('marvel_watchlist_state', JSON.stringify(state));
renderTable();
}
​function resetList() {
if (confirm("Are you sure you want to reset all your progress?")) {
state = {};
saveAndRender();
}
}
​function exportData() {
const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(state, null, 2));
const downloadAnchor = document.createElement('a');
downloadAnchor.setAttribute("href", dataStr);
downloadAnchor.setAttribute("download", "marvel_watchlist_progress.json");
document.body.appendChild(downloadAnchor);
downloadAnchor.click();
downloadAnchor.remove();
}
​// Initial Load
renderTable();
</script>
</body>
</html>
